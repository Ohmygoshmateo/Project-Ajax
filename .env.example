# Alpaca PAPER credentials — used by the scanner, backtester, and scheduled agent.
# Create a free paper account at https://alpaca.markets and paste the keys here.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Alpaca LIVE credentials — REAL MONEY.
# Read by src/ajax/live/gate.py and by nothing else. The scheduled agent never
# loads these. Leave blank unless you have deliberately completed `ajax enable-live`.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
